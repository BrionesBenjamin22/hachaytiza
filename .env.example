# Runtime environment. Supported values: development, production.
NODE_ENV=development

# API listening port.
PORT=3001

# Exact, comma-separated frontend origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL/PostGIS. Supply a local password; never commit real credentials.
POSTGRES_USER=hyt
POSTGRES_DB=hyt
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=

# Generate two different random secrets of at least 32 characters.
JWT_SECRET=
CSRF_SECRET=
FRONTEND_URL=http://localhost:3000

# Resend configuration. Required in production and to receive real development emails.
RESEND_API_KEY=
EMAIL_FROM=

# Frontend public settings; put these in apps/web/.env.local for Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120
