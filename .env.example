# Runtime environment. Supported values: development, production.
NODE_ENV=development

# API listening port.
PORT=3001

# Exact, comma-separated frontend origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL/PostGIS. Supply a local password; never commit real credentials.
POSTGRES_USER=hyt
POSTGRES_DB=hyt
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
# Container URL: same credentials/database, hostname db, internal port 5432.
# DATABASE_URL above is for Prisma/API running directly on the host.
DOCKER_DATABASE_URL=

# Generate two different random secrets of at least 32 characters.
JWT_SECRET=
CSRF_SECRET=
FRONTEND_URL=http://localhost:3000

# Resend configuration. Required in production and to receive real development emails.
RESEND_API_KEY=
EMAIL_FROM=

# Frontend public settings; put these in apps/web/.env.local for Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120

# Compose host ports; internal application ports stay 3000/3001.
WEB_PORT=3000
API_PORT=3001
DOCKER_BIND_ADDRESS=127.0.0.1
# Optional resource overrides: WEB_MEMORY_LIMIT/API_MEMORY_LIMIT/DB_MEMORY_LIMIT=1g;
# WEB_CPU_LIMIT/API_CPU_LIMIT=1.0, DB_CPU_LIMIT=2.0;
# WEB_PIDS_LIMIT/API_PIDS_LIMIT=512, DB_PIDS_LIMIT=256.
# Log rotation defaults: DOCKER_LOG_MAX_SIZE=10m, DOCKER_LOG_MAX_FILE=3.
